# Neon Serverless PostgreSQL connection string (include ?sslmode=require)
# Example: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=
# Example: DATABASE_URL="postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/focusflow?sslmode=require"

# Single-user auth passphrase (required for login)
# Set a strong passphrase for production deployments.
ADMIN_PASSPHRASE=changeme
